# Copy these values into the process environment; do not commit a real .env file.
# Local development values
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500

# Production / Vercel serverless values
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_DB=online_event_verification
PASS_ENCRYPTION_KEY=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Event Administrator
# Generate with: $env:ADMIN_PASSWORD='a-long-random-password'; npm run admin:hash
ADMIN_PASSWORD_HASH=replace-with-generated-scrypt-hash
